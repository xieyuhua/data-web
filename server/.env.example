# ===== 服务端口 =====
PORT=8486
# 监听地址：留空 = 监听全部网卡，局域网设备可直接访问
# 只允许本机访问时填 127.0.0.1
HOST=

# ===== 数据库 =====
# sqlite 或 mysql
DB_DRIVER=sqlite
# SQLite 示例：data/bi.db
# MySQL 示例：bi:bi_password@tcp(127.0.0.1:3306)/bi_platform?charset=utf8mb4&parseTime=True&loc=Local
DB_DSN=data/bi.db

# ===== 安全 =====
# 生产环境必须替换为随机长字符串（至少 16 位）
JWT_SECRET=change-me-in-production-bi-platform-2026
JWT_EXPIRE_HOURS=24

# ===== 地址 =====
# 后端对外地址（用于接口文档/回调）
API_BASE_URL=http://localhost:8486
# 前端访问地址（用于生成分享链接）
# 留空 = 按浏览器访问请求的 Host 自动生成，局域网 / 反向代理场景最省心；
# 如需固定域名再填写，例如 https://bi.example.com
WEB_BASE_URL=
# 前后端同源访问时无需配置；使用 Vite 开发服务器（5173）时再放开对应来源
CORS_ORIGINS=http://localhost:8486,http://127.0.0.1:8486,http://localhost:5173,http://127.0.0.1:5173

# ===== 应用行为 =====
APP_TIMEZONE=Asia/Shanghai
AUTO_MIGRATE=true
SEED_DEMO_DATA=true
# 无真实企业微信/微信凭证时，推送记录为 simulated（演练），不会真正发送
ALLOW_MOCK_PUSH=true
SQL_QUERY_TIMEOUT_SECONDS=10

# ===== 静态资源 =====
# 生产可由 Gin 直接托管已构建的前端
WEB_DIST_DIR=../web/dist
